{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "supervisor-finder",
  "version": "0.1.0",
  "identifier": "com.manti.supervisor-finder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "supervisor-finder",
        "label": "main",
        "width": 900,
        "height": 900,
        "minWidth": 900,
        "minHeight": 900,
        "url": "index.html",
        "resizable": true,
        "decorations": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../api",
      "../src"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
